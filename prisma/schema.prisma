generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "persons", "commerce", "strategic"]
}

/**
 * #############################################
 * ##          ENUMERADORES                   ##
 * #############################################
 */

enum TipoDocumento {
  dni
  ce
  pasaporte
  ruc

  @@map("tipo_documento_enum")
  @@schema("persons")
}

enum TipoCliente {
  persona_natural @map("persona natural")
  empresa

  @@map("tipo_cliente_enum")
  @@schema("persons")
}

enum CategoriaCliente {
  minorista
  mayorista

  @@map("categoria_cliente_enum")
  @@schema("persons")
}

enum ReferenciaTipo {
  pedido
  pago
  reembolso
  promocion

  @@map("referencia_tipo_enum")
  @@schema("persons")
}

enum AreaEmpleado {
  ventas
  almacen
  produccion
  administracion

  @@map("area_empleado_enum")
  @@schema("persons")
}

enum TipoEventoNotificacion {
  pago_confirmado
  pago_rechazado
  pedido_en_camino
  pedido_entregado
  reembolso_aprobado
  reembolso_rechazado
  reembolso_procesado
  ticket_respondido
  promocion
  mantenimiento

  @@map("tipo_evento_notificacion_enum")
  @@schema("persons")
}

enum UnidadMedidaPresentacion {
  kg
  gr

  @@map("unidad_medida_presentacion_enum")
  @@schema("commerce")
}

enum TipoPromocion {
  porcentaje
  monto_fijo
  nxm
  regalo

  @@map("tipo_promocion")
  @@schema("commerce")
}

enum UnidadMedidaInsumo {
  kg
  litros
  unidad

  @@map("unidad_medida_insumo_enum")
  @@schema("commerce")
}

enum TipoInsumo {
  materia_prima
  empaque

  @@map("tipo_insumo_enum")
  @@schema("commerce")
}

enum EstadoLoteInsumo {
  activo
  agotado
  vencido

  @@map("estado_lote_insumo_enum")
  @@schema("commerce")
}

enum TipoMovimientoInsumo {
  entrada
  salida
  ajuste

  @@map("tipo_movimiento_insumo_enum")
  @@schema("commerce")
}

enum OrigenPedido {
  portal
  manual

  @@map("origen_pedido_enum")
  @@schema("commerce")
}

// Estados del portal interno (RN6). El pedido nace en `confirmado`: solo se
// registra cuando el pago ya está confirmado (RN5).
enum EstadoPedido {
  confirmado
  en_espera_inventario
  en_preparacion
  pendiente_entrega
  en_camino
  entregado
  cancelado

  @@map("estado_pedido_enum")
  @@schema("commerce")
}

enum TipoEntrega {
  recojo_tienda
  delivery

  @@map("tipo_entrega_enum")
  @@schema("commerce")
}

enum MetodoPago {
  efectivo
  culqi

  @@map("metodo_pago_enum")
  @@schema("commerce")
}

enum TipoComprobante {
  boleta
  factura

  @@map("tipo_comprobante")
  @@schema("commerce")
}

// RN de reembolso: nace en `pendiente`; ventas lo aprueba o lo rechaza (sin
// vuelta atrás), y solo tras aprobarse pasa a `reembolsado` al devolverse el dinero.
enum EstadoReembolso {
  pendiente
  aprobado
  rechazado
  reembolsado

  @@map("estado_reembolso_enum")
  @@schema("commerce")
}

/**
 * #######################################################################
 * ##   BLOQUE 1: TABLAS relacionadas a persona, seguridad y empresa    ##
 * #########################################################3#############
 */

model Persona {
  id               String        @id(map: "pk_persona") @default(uuid()) @db.Uuid
  nombres          String        @db.VarChar(100)
  apellido_paterno String        @db.VarChar(100)
  apellido_materno String        @db.VarChar(100)
  tipo_documento   TipoDocumento
  numero_documento String        @unique(map: "uq_persona_numero_documento") @db.VarChar(20)
  telefono         String?       @db.VarChar(9)
  fecha_nacimiento DateTime?     @db.Date
  direccion        String?       @db.Text
  estado           Boolean       @default(true)
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  empleado         Empleado?
  cliente          Cliente?
  user             User?

  @@map("persona")
  @@schema("persons")
}

model Empleado {
  id            String        @id(map: "pk_empleado") @default(uuid()) @db.Uuid
  persona_id    String        @unique(map: "uq_empleado_persona_id") @db.Uuid
  cargo         String?       @db.VarChar(100)
  area          AreaEmpleado?
  fecha_ingreso DateTime?     @db.Date
  fecha_des_lab DateTime?     @db.Date
  estado        Boolean       @default(true)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  persona       Persona       @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_empleado_persona")

  @@map("empleado")
  @@schema("persons")
}

model Cliente {
  id                String           @id(map: "pk_cliente") @default(uuid()) @db.Uuid
  persona_id        String           @unique(map: "uq_cliente_persona_id") @db.Uuid
  tipo_cliente      TipoCliente
  razon_social      String?          @db.VarChar(200)
  categoria_cliente CategoriaCliente
  estado            Boolean          @default(true)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  persona           Persona          @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cliente_persona")
  pedidos           Pedido[]

  @@map("cliente")
  @@schema("persons")
}

model User {
  id                                  String             @id(map: "pk_user") @default(uuid()) @db.Uuid
  persona_id                          String             @unique(map: "uq_user_persona_id") @db.Uuid
  email                               String             @unique(map: "uq_user_email") @db.VarChar(150)
  username                            String             @unique(map: "uq_user_username") @db.VarChar(50)
  contrasena                          String             @map("contraseña") @db.VarChar(255)
  estado                              Boolean            @default(true)
  token_recuperacion                  String?            @db.VarChar(255)
  token_expiracion                    DateTime?          @db.Timestamptz(6)
  debe_cambiar_contrasena             Boolean            @default(false)
  email_verificado                    Boolean            @default(false)
  token_verificacion_email            String?            @db.VarChar(255)
  token_verificacion_email_expiracion DateTime?          @db.Timestamptz(6)
  created_at                          DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  persona                             Persona            @relation(fields: [persona_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user_persona")
  usuario_roles                       UsuarioRol[]
  notificacion_users                  NotificacionUser[]
  refresh_tokens                      RefreshToken[]
  pedidos                             Pedido[]
  reembolsos_resueltos                Reembolso[]

  @@map("user")
  @@schema("persons")
}

// modelo para token expiracion 7d
model RefreshToken {
  id         String    @id(map: "pk_refresh_token") @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique(map: "uq_refresh_token_hash") @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user       User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_refresh_token_user")

  @@index([user_id], map: "idx_refresh_token_user")
  @@map("refresh_token")
  @@schema("persons")
}

model Rol {
  id            Int          @id(map: "pk_rol") @default(autoincrement())
  nombre        String       @unique(map: "uq_rol_nombre") @db.VarChar(50)
  descripcion   String?      @db.VarChar(255)
  estado        Boolean      @default(true)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  accesos       Acceso[]
  usuario_roles UsuarioRol[]

  @@map("rol")
  @@schema("persons")
}

model Ruta {
  id          Int      @id(map: "pk_ruta") @default(autoincrement())
  nombre      String   @unique(map: "uq_ruta_nombre") @db.VarChar(100)
  etiqueta    String   @db.VarChar(150)
  icono       String   @db.VarChar(50)
  descripcion String?  @db.VarChar(255)
  estado      Boolean  @default(true)
  parent_id   Int?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  parent      Ruta?    @relation("RutaJerarquia", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ruta_parent")
  children    Ruta[]   @relation("RutaJerarquia")
  accesos     Acceso[]

  @@map("ruta")
  @@schema("persons")
}

model Acceso {
  id         Int      @id(map: "pk_acceso") @default(autoincrement())
  rol_id     Int
  ruta_id    Int
  estado     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  rol        Rol      @relation(fields: [rol_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_acceso_rol")
  ruta       Ruta     @relation(fields: [ruta_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_acceso_ruta")

  @@unique([rol_id, ruta_id], map: "uq_acceso_rol_ruta")
  @@map("acceso")
  @@schema("persons")
}

model UsuarioRol {
  id         Int      @id(map: "pk_usuario_rol") @default(autoincrement())
  user_id    String   @db.Uuid
  rol_id     Int
  estado     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario_rol_user")
  rol        Rol      @relation(fields: [rol_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario_rol_rol")

  @@unique([user_id, rol_id], map: "uq_usuario_rol")
  @@map("usuario_rol")
  @@schema("persons")
}

model Notificacion {
  id                 Int                    @id(map: "pk_notificacion") @default(autoincrement())
  tipo               TipoEventoNotificacion
  titulo             String                 @db.VarChar(150)
  mensaje            String                 @db.Text
  referencia_id      String?                @db.VarChar(50) // Referencia polimórfica: puede almacenar UUID o ID numérico como texto
  referencia_tipo    ReferenciaTipo?
  created_at         DateTime               @default(now()) @db.Timestamptz(6)
  notificacion_users NotificacionUser[]

  @@map("notificacion")
  @@schema("persons")
}

model NotificacionUser {
  notificacion_id Int
  user_id         String       @db.Uuid
  leido           Boolean      @default(false)
  fecha_leido     DateTime?    @db.Timestamptz(6)
  sns_message_id  String?      @db.VarChar(100)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  notificacion    Notificacion @relation(fields: [notificacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_notificacion_user_notif")
  user            User         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_notificacion_user_user")

  @@id([notificacion_id, user_id], map: "pk_notificacion_user")
  @@map("notificacion_user")
  @@schema("persons")
}

model Empresa {
  id           Int      @id(map: "pk_empresa") @default(autoincrement())
  razon_social String   @db.VarChar(200)
  ruc          String   @unique(map: "uq_empresa_ruc") @db.Char(11)
  direccion    String   @db.Text
  telefono     String?  @db.VarChar(9)
  email        String?  @unique(map: "uq_empresa_email") @db.VarChar(100)
  logo_url     String?  @db.Text
  estado       Boolean  @default(true)
  // Marca la empresa emisora de comprobantes. Índice único parcial
  // uq_empresa_emisora (solo una con true) en la migración: Prisma no lo modela.
  es_emisora   Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("empresa")
  @@schema("persons")
}

/**
 * #########################################################
 * ##   BLOQUE 2: TABLAS relacionadas a catalogo          ##
 * #########################################################
 */

model Categoria {
  id          Int      @id(map: "pk_categoria") @default(autoincrement())
  nombre      String   @db.VarChar(100)
  descripcion String?  @db.VarChar(255)
  estado      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  productos Producto[]

  @@map("categoria")
  @@schema("commerce")
}

model Producto {
  id           Int      @id(map: "pk_producto") @default(autoincrement())
  categoria_id Int
  nombre       String   @db.VarChar(100)
  descripcion  String?  @db.Text
  estado       Boolean  @default(true)
  destacado    Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  categoria Categoria @relation(fields: [categoria_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_producto_categoria")

  producto_presentaciones ProductoPresentacion[]

  @@map("producto")
  @@schema("commerce")
}

model Presentacion {
  id            Int                      @id(map: "pk_presentacion") @default(autoincrement())
  cantidad      Int
  unidad_medida UnidadMedidaPresentacion
  descripcion   String?                  @db.VarChar(255)
  estado        Boolean                  @default(true)
  created_at    DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at    DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)

  producto_presentaciones ProductoPresentacion[]

  @@map("presentacion")
  @@schema("commerce")
}

model ProductoPresentacion {
  id               Int      @id(map: "pk_producto_presentacion") @default(autoincrement())
  sku              String   @unique(map: "uq_producto_presentacion_sku") @db.VarChar(100)
  precio_unitario  Decimal  @db.Decimal(10, 2)
  precio_mayorista Decimal? @db.Decimal(10, 2)
  umbral_mayorista Int?
  producto_id      Int
  presentacion_id  Int
  // Solo la key dentro de francos-media (productos/<uuid>.<ext>); la URL se arma al responder.
  imagen_key       String?  @db.VarChar(255)
  slug             String?  @unique(map: "uq_producto_presentacion_slug") @db.VarChar(100)
  estado           Boolean  @default(true)
  // Nace oculta del catálogo del cliente (RF-A025) hasta que se active a mano.
  visible_portal_b Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  promociones        Promocion[]        @relation("PromocionProducto")
  promociones_regalo Promocion[]        @relation("PromocionRegalo")
  producto_terminado ProductoTerminado?
  detalles_pedido    DetallePedido[]

  producto Producto @relation(fields: [producto_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_producto_presentacion_producto")

  presentacion Presentacion @relation(fields: [presentacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_producto_presentacion_presentacion")

  @@unique([producto_id, presentacion_id], map: "uq_producto_presentacion_producto_presentacion")
  @@map("producto_presentacion")
  @@schema("commerce")
}

model Promocion {
  id                              Int           @id(map: "pk_promocion") @default(autoincrement())
  producto_presentacion_id        Int
  nombre                          String        @db.VarChar(150)
  tipo                            TipoPromocion
  valor                           Decimal       @db.Decimal(10, 2)
  cantidad_paga                   Int?
  cantidad_lleva                  Int?
  cantidad_minima                 Int?
  producto_presentacion_regalo_id Int?
  fecha_inicio                    DateTime      @db.Date
  fecha_fin                       DateTime      @db.Date
  estado                          Boolean       @default(true)
  created_at                      DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  producto_presentacion ProductoPresentacion @relation("PromocionProducto", fields: [producto_presentacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_promocion_producto_presentacion")

  producto_presentacion_regalo ProductoPresentacion? @relation("PromocionRegalo", fields: [producto_presentacion_regalo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_promocion_regalo")

  @@map("promocion")
  @@schema("commerce")
}

// Pedido de venta (HU-A-009). El código PED-000001 sale del id (RF-A034), así que
// es correlativo para cualquier origen. `user_id` es el trabajador que lo registró
// a mano; queda vacío en los pedidos que llegan del portal del cliente.
model Pedido {
  id                Int          @id(map: "pk_pedido") @default(autoincrement())
  codigo            String       @unique(map: "uq_pedido_codigo") @db.VarChar(20)
  cliente_id        String       @db.Uuid
  user_id           String?      @db.Uuid
  origen            OrigenPedido
  estado            EstadoPedido @default(confirmado)
  tipo_entrega      TipoEntrega
  // Solo para delivery; en recojo en tienda queda vacía.
  direccion_entrega String?      @db.Text
  total             Decimal      @db.Decimal(10, 2)
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  cliente  Cliente         @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedido_cliente")
  user     User?           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pedido_user")
  detalles DetallePedido[]
  pago     Pago?

  @@index([created_at], map: "idx_pedido_created_at")
  @@index([cliente_id], map: "idx_pedido_cliente")
  @@map("pedido")
  @@schema("commerce")
}

// Los precios se copian al registrar el pedido para que no cambien si después
// cambia el catálogo. `precio_aplicado` es el que se cobra: el unitario o el
// mayorista cuando la cantidad supera el umbral (RN17).
model DetallePedido {
  id                       Int      @id(map: "pk_detalle_pedido") @default(autoincrement())
  pedido_id                Int
  producto_presentacion_id Int
  cantidad                 Int
  precio_unitario          Decimal  @db.Decimal(10, 2)
  precio_aplicado          Decimal  @db.Decimal(10, 2)
  subtotal                 Decimal  @db.Decimal(10, 2)
  created_at               DateTime @default(now()) @db.Timestamptz(6)

  pedido                Pedido               @relation(fields: [pedido_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalle_pedido_pedido")
  producto_presentacion ProductoPresentacion @relation(fields: [producto_presentacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_detalle_pedido_producto_presentacion")

  @@unique([pedido_id, producto_presentacion_id], map: "uq_detalle_pedido_pedido_producto_presentacion")
  @@map("detalle_pedido")
  @@schema("commerce")
}

// Un pedido tiene un solo pago. No lleva estado: el pedido solo existe con el
// pago confirmado (RN5). En Culqi, `numero_operacion` es el id del cargo; en
// efectivo queda vacío.
model Pago {
  id               Int        @id(map: "pk_pago") @default(autoincrement())
  pedido_id        Int        @unique(map: "uq_pago_pedido")
  metodo_pago      MetodoPago
  monto            Decimal    @db.Decimal(10, 2)
  numero_operacion String?    @unique(map: "uq_pago_numero_operacion") @db.VarChar(100)
  fecha_pago       DateTime   @db.Timestamptz(6)
  created_at       DateTime   @default(now()) @db.Timestamptz(6)

  pedido    Pedido     @relation(fields: [pedido_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pago_pedido")
  reembolso Reembolso?

  @@map("pago")
  @@schema("commerce")
}

// Serie de comprobantes (HU-A-044, RN23). `correlativo_actual` es el último número
// emitido: nace en `correlativo_inicio - 1` y solo avanza con una reserva atómica.
// A lo sumo una serie activa por tipo (índice parcial `uq_serie_activa_por_tipo`) y
// los CHECK de rango se añaden a mano en la migración: Prisma no los modela.
model SerieComprobante {
  id                 Int             @id(map: "pk_serie_comprobante") @default(autoincrement())
  tipo               TipoComprobante
  serie              String          @unique(map: "uq_serie_comprobante_serie") @db.VarChar(4)
  correlativo_inicio Int
  correlativo_fin    Int
  correlativo_actual Int
  umbral_alerta      Int             @default(100)
  estado             Boolean         @default(true)
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("serie_comprobante")
  @@schema("commerce")
}

// Solicitud de reembolso de un pedido pagado (HU-A-011). La registra el cliente
// desde su portal (HU-B-014); `pago_id` único = una sola solicitud por pedido.
// La evidencia es un archivo del bucket de documentos; aquí va su llave.
model Reembolso {
  id               Int             @id(map: "pk_reembolso") @default(autoincrement())
  codigo           String          @unique(map: "uq_reembolso_codigo") @db.VarChar(20)
  pago_id          Int             @unique(map: "uq_reembolso_pago")
  monto            Decimal         @db.Decimal(10, 2)
  motivo_cliente   String          @db.Text
  evidencia_key    String?         @db.VarChar(255)
  estado           EstadoReembolso @default(pendiente)
  motivo_rechazo   String?         @db.Text
  // Operador de ventas que la aprobó o la rechazó.
  resuelto_por     String?         @db.Uuid
  fecha_solicitud  DateTime        @default(now()) @db.Timestamptz(6)
  fecha_resolucion DateTime?       @db.Timestamptz(6)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  pago              Pago  @relation(fields: [pago_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reembolso_pago")
  resuelto_por_user User? @relation(fields: [resuelto_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reembolso_resuelto_por")

  @@index([estado], map: "idx_reembolso_estado")
  @@index([fecha_solicitud], map: "idx_reembolso_fecha_solicitud")
  @@map("reembolso")
  @@schema("commerce")
}

/**
 * #########################################################
 * ##   BLOQUE 3: TABLAS relacionadas a estrategia        ##
 * #########################################################
 */

// Existencias de una presentación de producto, siempre contadas en unidades. Se
// crea sola con cada presentación (RF-A024) y su stock solo cambia con movimientos
// de inventario. No tiene `estado` propio: no se activa ni desactiva directamente,
// sigue al de la presentación.
model ProductoTerminado {
  id                       Int      @id(map: "pk_producto_terminado") @default(autoincrement())
  producto_presentacion_id Int      @unique(map: "uq_producto_terminado_producto_presentacion")
  stock_actual             Decimal  @default(0) @db.Decimal(10, 2)
  stock_minimo             Decimal  @default(1) @db.Decimal(10, 2)
  stock_maximo             Decimal? @db.Decimal(10, 2)
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  updated_at               DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  producto_presentacion ProductoPresentacion @relation(fields: [producto_presentacion_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_producto_terminado_producto_presentacion")

  @@map("producto_terminado")
  @@schema("commerce")
}

// Insumos de producción (materia prima y empaque), independientes del catálogo
// de venta (Producto/Presentacion). Su stock se ajustará con movimientos de
// inventario cuando esa funcionalidad se construya; por ahora el CRUD solo
// gestiona la ficha y el stock se edita directamente.
model Insumo {
  id            Int                @id(map: "pk_insumo") @default(autoincrement())
  sku           String             @unique(map: "uq_insumo_sku") @db.VarChar(100)
  nombre        String             @db.VarChar(150)
  descripcion   String?            @db.VarChar(255)
  unidad_medida UnidadMedidaInsumo
  stock_actual  Decimal            @default(0) @db.Decimal(10, 2)
  stock_minimo  Decimal            @db.Decimal(10, 2)
  stock_maximo  Decimal            @db.Decimal(10, 2)
  tipo          TipoInsumo
  estado        Boolean            @default(true)
  created_at    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at    DateTime           @default(now()) @updatedAt @db.Timestamptz(6)

  lotes LoteInsumo[]

  @@map("insumo")
  @@schema("commerce")
}

// Sin edición: una vez creado un lote, solo cambia su cantidad_actual (vía
// movimientos, cuando ese módulo exista) o se da de baja lógicamente (activo).
// "estado" es el ciclo de vida de negocio (se agota o vence solo); "activo" es
// el borrado lógico administrativo — son conceptos independientes a propósito.
model LoteInsumo {
  id                Int              @id(map: "pk_lote_insumo") @default(autoincrement())
  insumo_id         Int
  codigo_lote       String           @unique(map: "uq_lote_insumo_codigo") @db.VarChar(50)
  fecha_ingreso     DateTime         @db.Date
  fecha_vencimiento DateTime?        @db.Date
  cantidad_inicial  Decimal          @db.Decimal(10, 2)
  cantidad_actual   Decimal          @db.Decimal(10, 2)
  estado            EstadoLoteInsumo @default(activo)
  activo            Boolean          @default(true)
  created_at        DateTime         @default(now()) @db.Timestamptz(6)
  updated_at        DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  insumo Insumo @relation(fields: [insumo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_lote_insumo_insumo")

  movimientos MovimientoInsumo[]

  @@map("lote_insumo")
  @@schema("commerce")
}

// Kardex de insumos: registro histórico e inmutable (sin updated_at, sin
// activo/estado propio — nunca se edita ni se borra, solo se agrega).
// stock_anterior/stock_resultante los completa un trigger (ver migración),
// no la aplicación: siempre reflejan el estado real del lote en ese instante.
// cantidad es positiva para entrada/salida (la dirección la da "tipo"); para
// ajuste puede ser positiva o negativa (corrección hacia arriba o abajo).
model MovimientoInsumo {
  id               Int                  @id(map: "pk_movimiento_insumo") @default(autoincrement())
  lote_insumo_id   Int
  tipo             TipoMovimientoInsumo
  cantidad         Decimal              @db.Decimal(10, 2)
  stock_anterior   Decimal              @default(0) @db.Decimal(10, 2)
  stock_resultante Decimal              @default(0) @db.Decimal(10, 2)
  razon            String               @db.VarChar(255)
  fecha            DateTime             @default(now()) @db.Timestamptz(6)
  created_at       DateTime             @default(now()) @db.Timestamptz(6)

  lote_insumo LoteInsumo @relation(fields: [lote_insumo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_movimiento_insumo_lote")

  @@map("movimiento_insumo")
  @@schema("commerce")
}

