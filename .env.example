PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/francos_erp?schema=public"
JWT_SECRET=your_super_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=40m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
FRONTEND_STORE_URL=http://localhost:4200
FRONTEND_PORTAL_URL=http://localhost:4201

SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@example.com
SMTP_PASS=placeholder
SMTP_FROM=noreply@francos.local

# MinIO local (compatible con S3). En AWS real NO se definen S3_ENDPOINT,
# S3_ACCESS_KEY_ID ni S3_SECRET_ACCESS_KEY — el backend usa el rol IAM de la
# tarea automáticamente. Si se definieran las claves igual, el SDK las usaría
# a ellas en vez del rol: evitarlo en el despliegue de AWS a propósito.
# S3_FORCE_PATH_STYLE tampoco se define en AWS (default false).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ROOTUSER
S3_SECRET_ACCESS_KEY=CHANGEME123
S3_FORCE_PATH_STYLE=true
S3_BUCKET_DOCS=francos-docs
S3_BUCKET_MEDIA=francos-media
# URL base con la que la API arma la URL de las imágenes (base + '/' + key).
# Opcional: en AWS queda el default /media (lo resuelve CloudFront).
MEDIA_BASE_URL=http://localhost:9000/francos-media
